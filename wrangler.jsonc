{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "bknd-cloudflare",
   "main": "src/index.ts",
   "compatibility_date": "2025-11-25",
   "compatibility_flags": ["nodejs_compat"],
   "workers_dev": true,
   "minify": true,
   "assets": {
      "directory": "node_modules/bknd/dist/static"
   },
   "observability": {
      "enabled": true
   },
   "d1_databases": [
      {
         "binding": "DB","database_id": "80ec2802-cdcc-40fe-85b0-19650d54cf81","database_name": "bknd-db"
      }
   ],
   "r2_buckets": [
      {
         "binding": "BUCKET","bucket_name": "bknd-r2","preview_bucket_name": "bknd-r2"
      }
   ]
}
